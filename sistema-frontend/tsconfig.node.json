{
  "compilerOptions": {
    "esModuleInterop": true,
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,

    "baseUrl": "./src",
    "paths": {
      "@/*": ["*"],
      "@components/*": ["components/*"],
      "@pages/*": ["pages/*"],
      "@utils/*": ["utils/*"],
      "@layouts/*": ["layouts/*"],
      "@customTypes/*": ["types/*"],
      "@reduxConfig/*": ["redux/*"],
      "@store/*": ["store/*"],
      "@skins/*": ["skins/*"],
      "@editor/*": ["editor/*"]
    }

  },
  "include": ["vite.config.ts"]
}
